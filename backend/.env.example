# AI Provider (gemini or groq)
AI_PROVIDER=groq

# Google Gemini API (currently quota-exhausted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq API (free alternative - get key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Application
ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-this

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# JUDGES & OPPONENT API
JUDGE_API_KEY=your_groq_key_1
OPPONENT_API_KEY=your_groq_key_2

# Vector Database
VECTOR_DB_PATH=./data/vector_db

# Logging
LOG_LEVEL=INFO

# Sarvam AI
SARVAM_API_KEY=...your_sarvam_api_key_here..
#ELEVENLABS_API_KEY
ELEVENLABS_API_KEY=...your_elevenlabs_api_key_here..
JWT_SECRET_KEY= your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_FRONTEND_SUCCESS_URI=http://localhost:3000/authentication

# Database
MONGODB_URI=your_mongodb_uri_here