# AI Provider (gemini or groq)
AI_PROVIDER=groq

# Google Gemini API (currently quota-exhausted)
GEMINI_API_KEY=your_api_secret
GEMINI_MODEL=gemini-2.0-flash

# Groq API (free alternative - get key at https://console.groq.com)
GROQ_API_KEY=your_api_secret
GROQ_MODEL=llama-3.3-70b-versatile

# Application
ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-this

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# JUDGES & OPPONENT API
JUDGE_API_KEY=your_groq_key_1
OPPONENT_API_KEY=your_groq_key_2

# Vector Database
VECTOR_DB_PATH=./data/vector_db

# Logging
LOG_LEVEL=INFO

# Sarvam AI
SARVAM_API_KEY=your_api_key
#ELEVENLABS_API_KEY
ELEVENLABS_API_KEY=your

# Cloudinary (audio file CDN - replaces local cache/ folder)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# JWT
JWT_SECRET_KEY=your_api_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_api_key
GOOGLE_CLIENT_SECRET=your_api_key
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_FRONTEND_SUCCESS_URI=http://localhost:3000/authentication

# Database
MONGODB_URI=your_groq_key_2

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
